# Files that end up inside Linux containers must keep LF line endings even when
# checked out on Windows (core.autocrlf=true would otherwise convert them).
docker/**      text eol=lf
*.sh           text eol=lf
*.vcl          text eol=lf
*.conf         text eol=lf
*.ini          text eol=lf
*.tf           text eol=lf
*.tftpl        text eol=lf
Dockerfile     text eol=lf
*.ps1          text eol=crlf
